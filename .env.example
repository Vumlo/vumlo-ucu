# The secrets of the UCU installation. Copy to .env, fill it in, chmod 600 .env. Never commit .env.
# These never go in vumlo.toml. See vendor/vumlo-core/deploy/env.example for every variable.

# PostgreSQL. The host is the compose service `postgres`; the password is the one below.
DATABASE_URL=postgres://vumlo:change-me@postgres:5432/vumlo

# The password of the PostgreSQL user `vumlo` (the same as in DATABASE_URL).
POSTGRES_PASSWORD=change-me

# Sign-in with Google (only with [auth.google] in vumlo.toml).
# VUMLO__AUTH__GOOGLE__CLIENT_SECRET=

# SMTP relay password (only with a [mail.transport] of kind "smtp" in vumlo.toml).
# VUMLO__MAIL__TRANSPORT__PASSWORD=
