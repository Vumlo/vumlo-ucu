# Secrets: only .env.example is committed
.env
.env.*
!.env.example

# vendor/vumlo-core is committed (the unpacked release, so that Vercel can build the web app from
# this repository), but not what scripts/vumlo copies or generates into it
vendor/vumlo-core/vumlo.toml
vendor/vumlo-core/brand/
vendor/vumlo-core/.vumlo/
vendor/vumlo-core/web/node_modules/
vendor/vumlo-core/web/.next/
vendor/vumlo-core/web/src/generated/
vendor/vumlo-core/web/src/modules/enabled.ts
vendor/vumlo-core/web/public/brand/

# Builds and backups
backups/
*.dump
node_modules/
.next/
target/
dist/
