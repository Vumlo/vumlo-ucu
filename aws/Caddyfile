# Caddy on the AWS instance: only the API. The web app is on Vercel, which proxies /api/v1 here.
# Install as /etc/caddy/Caddyfile and set the back end's domain:  VUMLO_API_DOMAIN=api.example.edu
# Caddy gets and renews the certificate; the domain's A record must point at the instance first.
# The visitor's address arrives in X-Real-IP, set by Vercel; vumlo.toml has
# server.client_ip_header = "x-real-ip" so that the login limits see the visitor and not Vercel.

{$VUMLO_API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		respond "Not found" 404
	}
}
