#!/usr/bin/env bash
# Moves this repository to another vumlo-core release:
#
#   scripts/bump-core 0.1.1
#
# It writes core.version and core.sha256 (from the SHA256SUMS of that GitHub Release), fetches the
# archive, runs `config check` and `brand apply`, builds the images, and commits. If anything fails
# it puts core.version, core.sha256 and vendor/ back as they were, commits nothing, and exits 1.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

new="${1:?usage: scripts/bump-core <version>   (for example 0.1.1)}"
[[ "$new" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "bump-core: $new is not X.Y.Z" >&2; exit 2; }

if [ -n "$(git status --porcelain)" ]; then
    echo "bump-core: the working tree is not clean; commit or stash first" >&2
    exit 2
fi

old="$(tr -d '[:space:]' <core.version)"
if [ "$old" = "$new" ]; then
    echo "bump-core: core.version is already $new" >&2
    exit 2
fi

restore() {
    status=$?
    trap - EXIT
    if [ "$status" -ne 0 ]; then
        echo "bump-core: FAILED; putting back core $old" >&2
        git checkout -- core.version core.sha256
        scripts/fetch-core >&2 || echo "bump-core: could not restore vendor/ (run scripts/fetch-core)" >&2
    fi
    exit "$status"
}
trap restore EXIT

archive="vumlo-$new-source.tar.gz"
sums="$(curl --proto '=https' --tlsv1.2 -fsSL "https://github.com/Vumlo/vumlo-core/releases/download/v$new/SHA256SUMS")"
sha="$(printf '%s\n' "$sums" | sed -n "s/^\([0-9a-f]\{64\}\)  $archive\$/\1/p")"
[ -n "$sha" ] || { echo "bump-core: no $archive in the SHA256SUMS of release v$new" >&2; exit 1; }

echo "$new" >core.version
echo "$sha" >core.sha256

scripts/fetch-core
scripts/vumlo config check
scripts/vumlo brand apply
scripts/vumlo compose build

git add core.version core.sha256
git commit -q -m "chore: vumlo-core $new"
echo "bump-core: now on vumlo-core $new (was $old). Next: smoke test, then tag (README)."
